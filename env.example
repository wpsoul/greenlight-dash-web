# Copy this file to docker/.env and fill in. Put a TLS reverse proxy (Caddy, the platform's) in front of 127.0.0.1:8080.
GREENLIGHT_IMAGE=ghcr.io/wpsoul/greenlight-dash:10.9.2
GL_INSTANCE_URL=https://boards.example.com
# Second hostname for isolated HTML card previews, proxied to the same container (recommended):
GL_PREVIEW_ORIGIN=https://preview.boards.example.com
# docker compose run --rm greenlight hash-password   (paste the scrypt$... line)
GL_AUTH_PASSWORD_HASH=
# optional; generated into /data/secrets on first boot when empty
GL_SESSION_SECRET=
# core = browser app + agent API · render = + server rendering · full = + bundled agent runner
GL_PROFILE=full
# Runner credentials (Claude Code inside the container), ONE of:
#   GL_RUNNER_CLAUDE_OAUTH_TOKEN — run `claude setup-token` on a machine where Claude Code is logged in (subscription)
#   GL_RUNNER_ANTHROPIC_API_KEY  — an API key from console.anthropic.com (pay per use)
GL_RUNNER_CLAUDE_OAUTH_TOKEN=
GL_RUNNER_ANTHROPIC_API_KEY=
GL_LICENSE_KEY=
